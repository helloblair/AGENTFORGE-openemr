# ── Required ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
OPENEMR_BASE_URL=http://localhost:8300
OPENEMR_CLIENT_ID=your-client-id
OPENEMR_CLIENT_SECRET=your-client-secret

# ── Optional: hallucination check (GPT-4o-mini) ─────────────────────────────
OPENAI_API_KEY=sk-proj-...

# ── Optional: Langfuse observability ─────────────────────────────────────────
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_HOST=https://us.cloud.langfuse.com

# ── Optional: PHI redaction (enabled by default) ─────────────────────────────
# Set to 0 to disable PHI redaction in traces (local dev only).
# LANGFUSE_REDACT_PHI=0
