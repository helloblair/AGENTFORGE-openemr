# Veris Production Environment
# Copy to .env.production and fill in values before deploying.
#
# Usage: docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build

# ── Domain / IP ──────────────────────────────────────────────────────────────
# Your VPS public IP or domain name (no protocol, no trailing slash)
DOMAIN=YOUR_VPS_IP

# ── MariaDB ──────────────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=changeme_root
MYSQL_DATABASE=openemr
MYSQL_USER=openemr
MYSQL_PASSWORD=changeme_db

# ── OpenEMR Admin ────────────────────────────────────────────────────────────
OE_USER=admin
OE_PASS=changeme_admin

# ── Agent (Claude / LLM) ────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# OAuth2 credentials — leave blank on first boot.
# Run scripts/bootstrap-oauth.sh after OpenEMR is up to populate these.
OPENEMR_CLIENT_ID=
OPENEMR_CLIENT_SECRET=

# ── Optional ─────────────────────────────────────────────────────────────────
# GPT-4o-mini for hallucination checking (disabled if blank)
OPENAI_API_KEY=

# Langfuse observability (disabled if blank)
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_HOST=https://us.cloud.langfuse.com
