# Custom OpenEMR image with Veris Agent module baked in.
#
# Build: docker build -f Dockerfile.openemr -t openemr-veris .
# Run:   docker run -p 8300:80 -e MYSQL_HOST=... openemr-veris
#
# Used by docker-compose.prod.yml for production deployment on Vultr.

FROM openemr/openemr:7.0.2

ENV PORT=80
EXPOSE 80

# Veris Agent module — floating chat widget for the OpenEMR UI
COPY interface/modules/custom_modules/oe-module-veris-agent/ \
     /var/www/localhost/htdocs/openemr/interface/modules/custom_modules/oe-module-veris-agent/

# Production entrypoint — writes sqlconf.php from env vars so the image
# skips auto_configure.php when connecting to an existing database.
COPY docker/railway-entrypoint.sh /var/www/localhost/htdocs/openemr/railway-entrypoint.sh
RUN chmod +x /var/www/localhost/htdocs/openemr/railway-entrypoint.sh
CMD ["./railway-entrypoint.sh"]
